# Copy to .env and fill in. `zeos-farm-drone run` and `zeos-farm-drone serve` read this
# file, from the current directory and then the project root. A variable already set in
# the environment wins over it, and a command-line flag wins over both. The names are
# the Claude SDK's own, so a shell already set up for Claude needs no .env at all.
#
# None of this is needed by the rules, the tapes, the lint or the test suite. Only
# `--machine claude` wants a key.

ANTHROPIC_API_KEY=
# Overridden by --model.
ANTHROPIC_MODEL=claude-opus-5-5
