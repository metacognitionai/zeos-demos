# Copy to .env and fill in. Both `zeos-chat run` and `zeos-chat serve` read this file,
# from the current directory and then the project root; a variable already set in the
# environment wins over it, and a command-line flag wins over both. The Claude names are
# the SDK's own, so a shell already set up for Claude needs no .env at all.
#
# Nothing here is needed by the default stub model, the lint or the test suite. See the
# README's "Configuring it" section.

ANTHROPIC_API_KEY=
# Opus by default. The barge-in this case exists to demonstrate is an interrupted turn
# resumed from a diff, and smaller models lose the thread of one.
ANTHROPIC_MODEL=claude-opus-5

# -- mail ---------------------------------------------------------------------
#
# The `Email` button writes `mail.outbox`, and that write is the only effect in this demo
# that leaves the machine. **Nothing is sent unless MAIL_LIVE is set**: without it the
# letter is composed, the capability check still happens, and the page shows what would
# have gone. That is deliberate -- the point of the check is watching it refuse an effect
# that would otherwise happen, and a demo that mails somebody on first run is not one
# anybody wants twice.
#
# MAIL_TO defaults to the account itself, so the demonstration mails you your own
# conversation and needs one address rather than two.

# How a letter leaves. `desktop` (the default) needs none of the settings below: it
# writes the letter to MAIL_OUTBOX_DIR and opens it as a draft in your own mail client,
# where you press Send. `smtp` sends in the background and needs the account. `simulated`
# does neither and just reports what would have happened.
MAIL_TRANSPORT=desktop
MAIL_OUTBOX_DIR=outbox

# -- only for MAIL_TRANSPORT=smtp ---------------------------------------------
#
# Gmail and the rest require an *app-specific* password here, not the account password:
# a Google app password is 16 lowercase letters, and pasting the account password gives
# `535 5.7.8 BadCredentials`. On a Workspace domain an admin can disable app passwords
# altogether, in which case `desktop` is the way round it.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional. Defaults to MAIL_USERNAME.
MAIL_FROM=
# Optional. Defaults to MAIL_FROM.
MAIL_TO=
# Leave this blank. Arming a send in the file arms every run, including the ones you
# start to check something else; pass it for the one run that means it instead:
#   MAIL_LIVE=1 uv run zeos-chat serve --open
MAIL_LIVE=
